{
  "name": "@qrocodile/api",
  "version": "0.1.1-beta.0",
  "type": "module",
  "description": "Typed client for the QRocodile QR Code API — render styled QR codes as SVG or PNG",
  "license": "MIT",
  "author": "QRocodile",
  "homepage": "https://qrocodile.io/en/qr-code-api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qrocodile-io/qrocodile-api-node.git"
  },
  "bugs": {
    "url": "https://github.com/qrocodile-io/qrocodile-api-node/issues"
  },
  "keywords": [
    "qr",
    "qr-code",
    "qrcode",
    "qr-generator",
    "svg",
    "png",
    "api-client",
    "typescript",
    "qrocodile"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup && node scripts/check-dts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepack": "pnpm run build",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check",
    "prepublishOnly": "pnpm run codegen:check && pnpm run typecheck && pnpm run lint && pnpm run test",
    "signup": "node examples/signup.ts",
    "generate": "node examples/generate.ts",
    "logo": "node examples/logo.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  }
}
