{
  "name": "@pagebase/qr-api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Typed client for the QRocodile QR Code API (api.qrocodile.io)",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "codegen": "openapi-typescript http://localhost:3002/docs/json -o src/openapi.d.ts",
    "signup": "node examples/signup.ts",
    "generate": "node examples/generate.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.0"
  }
}
